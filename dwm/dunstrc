[global]
    force_xwayland = true
    follow = keyboard
    origin = top-right
    offset = (12, 32)
    width = 300
    height = (0, 180)
    notification_limit = 3
    gap_size = 6
    font = monospace 14
    format = "%s\n%b"
    padding = 8
    horizontal_padding = 10
    frame_width = 1
    frame_color = "#444444"
    separator_height = 1
    separator_color = "#444444"
    corner_radius = 0
    icon_position = off
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 260
    progress_bar_max_width = 280
    progress_bar_corner_radius = 0
    highlight = "#bbbbbb"

[urgency_low]
    background = "#222222"
    foreground = "#bbbbbb"
    timeout = 4

[urgency_normal]
    background = "#222222"
    foreground = "#eeeeee"
    timeout = 6

[urgency_critical]
    background = "#222222"
    foreground = "#eeeeee"
    frame_color = "#666666"
    timeout = 0

[desktop_controls]
    appname = dwm
    format = "%s"
    markup = no
    history_ignore = yes

[muted_audio]
    category = control.muted
    foreground = "#888888"
    highlight = "#888888"

[battery_low]
    category = battery.low
    foreground = "#e5b567"
    frame_color = "#e5b567"

[battery_critical]
    category = battery.critical
    foreground = "#e06c75"
    frame_color = "#e06c75"

[battery_full]
    category = battery.full
    foreground = "#888888"
