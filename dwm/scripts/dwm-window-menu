#!/bin/sh
set -eu

reset_hotcorner() {
	xprop -root -f _DWM_HOTCORNER_RESET 8s -set _DWM_HOTCORNER_RESET reset >/dev/null 2>&1 || :
}
trap reset_hotcorner EXIT

monitor=${1:-0}
windows=$(wmctrl -l -x | awk '
NF >= 4 {
	id = $1
	class = $4
	title = $0
	sub(/^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]*/, "", title)
	if (title == "")
		title = class
	labels[NR] = title
	ids[NR] = id
	counts[labels[NR]]++
}
END {
	for (i = 1; i <= NR; i++) {
		label = labels[i]
		if (counts[label] > 1)
			label = label " (" ++seen[label] ")"
		printf "%s\t%s\n", ids[i], label
	}
}')

[ -n "$windows" ] || exit 0
selection=$(printf '%s\n' "$windows" | cut -f2- | dmenu -m "$monitor" -i -l 12 -o -p window) || exit 0
id=$(printf '%s\n' "$windows" | awk -F '\t' -v selection="$selection" '$2 == selection { print $1; exit }')

[ -n "$id" ] || exit 1
wmctrl -i -a "$id"
