#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
from datetime import date


def describe_weather(code):
    descriptions = {
        0: 'clear', 1: 'mostly clear', 2: 'partly cloudy', 3: 'overcast',
        45: 'fog', 48: 'freezing fog', 51: 'light drizzle', 53: 'drizzle',
        55: 'heavy drizzle', 56: 'freezing drizzle', 57: 'freezing drizzle',
        61: 'light rain', 63: 'rain', 65: 'heavy rain', 66: 'freezing rain',
        67: 'freezing rain', 71: 'light snow', 73: 'snow', 75: 'heavy snow',
        77: 'snow grains', 80: 'light showers', 81: 'showers', 82: 'heavy showers',
        85: 'snow showers', 86: 'heavy snow showers', 95: 'thunderstorm',
        96: 'thunderstorm', 99: 'thunderstorm',
    }
    return descriptions.get(int(code), 'unknown')


def weather_art(code):
    code = int(code)
    if code == 0 or code == 1:
        return ('        \\   /', '         .-.', '      --(   )--', "         `-'", '        /   \\')
    if code in (45, 48):
        return ('       _ - _', '    _ (   ) _', '      (___)')
    if code in (51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82):
        return ('       .--.', '    .-(    ).', '   (___.______) ', "    '  '  '  '")
    if code in (71, 73, 75, 77, 85, 86):
        return ('       .--.', '    .-(    ).', '   (___.______) ', '     *  *  *')
    if code >= 95:
        return ('       .--.', '    .-(    ).', '   (___.______) ', '      / /')
    return ('       .--.', '    .-(    ).', '   (___.______)')


if '--forecast' in sys.argv[1:]:
    os.execlp('st', 'st', '-c', 'dwm-weather', '-t', 'weather', '-g', '54x20',
              '-e', sys.executable, os.path.abspath(__file__), '--show-forecast')

if '--show-forecast' in sys.argv[1:]:
    try:
        url = ('https://api.open-meteo.com/v1/forecast?latitude=33.1959&longitude=-117.3798'
               '&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m'
               '&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max'
               '&temperature_unit=fahrenheit&wind_speed_unit=mph'
               '&timezone=America%2FLos_Angeles&forecast_days=7')
        response = subprocess.run(
            ['curl', '--fail', '--silent', '--show-error', '--connect-timeout', '2',
             '--max-time', '12', '--max-filesize', '65536', url],
            capture_output=True, text=True, check=True, timeout=13)
        report = json.loads(response.stdout)
        current = report['current']
        daily = report['daily']
        print('oceanside, california')
        print('\ntoday')
        for line in weather_art(current['weather_code']):
            print(line)
        print(f"\nnow: {describe_weather(current['weather_code'])}, "
              f"{current['temperature_2m']:.0f}°f (feels like {current['apparent_temperature']:.0f}°f)")
        print(f"humidity: {current['relative_humidity_2m']}%  "
              f"wind: {current['wind_speed_10m']:.0f} mph\n")
        print('7-day forecast')
        for index, day in enumerate(daily['time']):
            forecast_date = date.fromisoformat(day)
            label = 'today' if index == 0 else forecast_date.strftime('%a %b %-d').lower()
            condition = describe_weather(daily['weather_code'][index])
            low = daily['temperature_2m_min'][index]
            high = daily['temperature_2m_max'][index]
            rain = daily['precipitation_probability_max'][index]
            print(f'{label:<10} {condition:<18} {low:.0f}–{high:.0f}°f  rain {rain}%')
    except (OSError, subprocess.SubprocessError):
        print('could not load forecast')
    except (KeyError, IndexError, TypeError, ValueError):
        print('weather data was incomplete')
    print('\npress enter to close')
    try:
        input()
    except EOFError:
        pass
    raise SystemExit

icon = ''
weather = 'n/a'
try:
    response = subprocess.run(
        ['curl', '--fail', '--silent', '--connect-timeout', '2', '--max-time', '4',
         '--max-filesize', '4096', '--get', '--data-urlencode', 'format=%t|%C',
         'https://wttr.in/Oceanside?u&lang=en'],
        capture_output=True, text=True, encoding='utf-8', check=True, timeout=5)
    temperature, condition = response.stdout.strip().split('|', 1)
    temperature = temperature.strip()
    condition = condition.strip().lower()
    if not re.fullmatch(r'[+-]?\d+(?:\.\d+)?°F', temperature):
        raise ValueError('invalid temperature')
    if not re.fullmatch(r'[a-z /-]{1,48}', condition):
        raise ValueError('invalid conditions')
    if 'thunder' in condition:
        icon = ''
    elif any(word in condition for word in ('snow', 'sleet', 'ice', 'blizzard')):
        icon = ''
    elif 'rain' in condition or 'drizzle' in condition:
        icon = ''
    elif any(word in condition for word in ('fog', 'mist', 'haze')):
        icon = ''
    elif 'sun' in condition:
        icon = ''
    elif condition == 'clear':
        icon = ''
    weather = f'{temperature} {condition}'
except (OSError, subprocess.SubprocessError, ValueError):
    pass

print(f'{icon} {weather}')
