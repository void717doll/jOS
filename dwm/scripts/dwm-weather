#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
from datetime import date

if '--forecast' in sys.argv[1:]:
    os.execlp('st', 'st', '-c', 'dwm-weather', '-t', 'weather', '-g', '80x30',
              '-e', sys.executable, os.path.abspath(__file__), '--show-forecast')

if '--show-forecast' in sys.argv[1:]:
    try:
        response = subprocess.run(
            ['curl', '--fail', '--silent', '--show-error', '--connect-timeout', '2',
             '--max-time', '12', '--max-filesize', '262144',
             'https://wttr.in/Oceanside?u&format=j1&lang=en'],
            capture_output=True, text=True, check=True, timeout=13)
        report = json.loads(response.stdout)
        current = report['current_condition'][0]
        area = report['nearest_area'][0]['areaName'][0]['value']
        condition = current['weatherDesc'][0]['value']
        print(f'{area}, california'.lower())
        now = (f"now: {condition}, {current['temp_F']}°f "
               f"(feels like {current['FeelsLikeF']}°f)")
        print(now.lower())
        print(f"humidity: {current['humidity']}%    wind: {current['winddir16Point']} {current['windspeedMiles']} mph")
        print(f"visibility: {current['visibility']} mi    uv: {current['uvIndex']}\n")
        print('forecast')
        for day in report.get('weather', [])[:3]:
            hourly = day.get('hourly', [])
            midday = min(
                hourly,
                key=lambda hour: abs(int(hour.get('time', '1200')) - 1200),
            ) if hourly else {}
            description = midday.get('weatherDesc', [{'value': 'unknown'}])[0]['value']
            forecast_date = date.fromisoformat(day['date']).strftime('%a %b %-d')
            rain = midday.get('chanceofrain', '0')
            print(f"{forecast_date:<10} {description:<22.22} "
                  f"{day['mintempF']}–{day['maxtempF']}°f  rain {rain}%")
    except (OSError, subprocess.SubprocessError):
        print('could not load forecast')
    except (KeyError, IndexError, TypeError, ValueError):
        print('weather data was incomplete')
    print('\npress enter to close')
    try:
        input()
    except EOFError:
        pass
    raise SystemExit

icon = ''
weather = 'n/a'
try:
    response = subprocess.run(
        ['curl', '--fail', '--silent', '--connect-timeout', '2', '--max-time', '4',
         '--max-filesize', '4096', '--get', '--data-urlencode', 'format=%t|%C',
         'https://wttr.in/Oceanside?u&lang=en'],
        capture_output=True, text=True, encoding='utf-8', check=True, timeout=5)
    temperature, condition = response.stdout.strip().split('|', 1)
    temperature = temperature.strip()
    condition = condition.strip().lower()
    if not re.fullmatch(r'[+-]?\d+(?:\.\d+)?°F', temperature):
        raise ValueError('invalid temperature')
    if not re.fullmatch(r'[a-z /-]{1,48}', condition):
        raise ValueError('invalid conditions')
    if 'thunder' in condition:
        icon = ''
    elif any(word in condition for word in ('snow', 'sleet', 'ice', 'blizzard')):
        icon = ''
    elif 'rain' in condition or 'drizzle' in condition:
        icon = ''
    elif any(word in condition for word in ('fog', 'mist', 'haze')):
        icon = ''
    elif 'sun' in condition:
        icon = ''
    elif condition == 'clear':
        icon = ''
    weather = f'{temperature} {condition}'
except (OSError, subprocess.SubprocessError, ValueError):
    pass

print(f'{icon} {weather}')
