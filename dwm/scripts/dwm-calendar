#!/usr/bin/env python3
import calendar
from datetime import date, timedelta
import os
from pathlib import Path
import select
import sys
import termios
import tty

if '--show' not in sys.argv[1:]:
    os.execlp('st', 'st', '-c', 'dwm-calendar', '-t', 'calendar', '-g', '36x22',
              '-e', str(Path(__file__).resolve()), '--show')


def nth_weekday(year, month, weekday, occurrence):
    first = date(year, month, 1)
    return first + timedelta(days=(weekday - first.weekday()) % 7 + 7 * (occurrence - 1))


def last_weekday(year, month, weekday):
    last = date(year, month, calendar.monthrange(year, month)[1])
    return last - timedelta(days=(last.weekday() - weekday) % 7)


def federal_holidays(year):
    dates = [
        (date(year, 1, 1), "new year's day"),
        (nth_weekday(year, 1, calendar.MONDAY, 3), 'martin luther king jr. day'),
        (nth_weekday(year, 2, calendar.MONDAY, 3), "washington's birthday"),
        (last_weekday(year, 5, calendar.MONDAY), 'memorial day'),
        (date(year, 6, 19), 'juneteenth'),
        (date(year, 7, 4), 'independence day'),
        (nth_weekday(year, 9, calendar.MONDAY, 1), 'labor day'),
        (nth_weekday(year, 10, calendar.MONDAY, 2), 'columbus day'),
        (date(year, 11, 11), 'veterans day'),
        (nth_weekday(year, 11, calendar.THURSDAY, 4), 'thanksgiving'),
        (date(year, 12, 25), 'christmas day'),
    ]
    observed = []
    for holiday, name in dates:
        observed.append((holiday, name, False))
        if holiday.weekday() == calendar.SATURDAY:
            observed.append((holiday - timedelta(days=1), name, True))
        elif holiday.weekday() == calendar.SUNDAY:
            observed.append((holiday + timedelta(days=1), name, True))
    return observed


holiday_labels = {
    "new year's day": 'new year',
    'martin luther king jr. day': 'mlk day',
    "washington's birthday": 'wash. bday',
    'memorial day': 'memorial',
    'juneteenth': 'juneteenth',
    'independence day': 'july 4',
    'labor day': 'labor day',
    'columbus day': 'columbus',
    'veterans day': 'veterans',
    'thanksgiving': 'thanks',
    'christmas day': 'christmas',
}


def render_month(year, month):
    holidays = [item for holiday_year in (year - 1, year, year + 1)
                for item in federal_holidays(holiday_year)
                if item[0].year == year and item[0].month == month]
    events = {holiday.day: holiday_labels[name] for holiday, name, _ in holidays}
    today = date.today()
    width = 34
    border = '+' + '-' * width + '+'
    print(border)
    print('|' + f'{calendar.month_name[month]} {year}'.center(width).lower() + '|')
    print(border)
    headings = ' '.join(day.center(4) for day in ('su', 'mo', 'tu', 'we', 'th', 'fr', 'sa'))
    print('|' + headings + '|')
    for week in calendar.Calendar(calendar.SUNDAY).monthdayscalendar(year, month):
        cells = []
        for day in week:
            if day == 0:
                cell = ''
            elif day == today.day and month == today.month and year == today.year:
                cell = f'[{day}]'
            else:
                cell = str(day) + ('*' if day in events else '')
            cells.append(cell.center(4))
        print('|' + ' '.join(cells) + '|')
    print(border)
    print('\nus federal holidays')
    for holiday, name, observed in holidays:
        suffix = ' (observed)' if observed else ''
        print(f'{holiday.day:2}  {name}{suffix}'.lower())
    print('\nleft/right: previous/next month')
    print('t: today   q: close', end='', flush=True)


def read_key(fd):
    key = os.read(fd, 1)
    if key == b'\x1b':
        ready, _, _ = select.select([fd], [], [], 0.08)
        if ready:
            if os.read(fd, 1) == b'[':
                ready, _, _ = select.select([fd], [], [], 0.08)
                if ready:
                    key = os.read(fd, 1)
                    if key == b'D':
                        return 'previous'
                    if key == b'C':
                        return 'next'
        return 'quit'
    if key in (b'h', b'H'):
        return 'previous'
    if key in (b'l', b'L'):
        return 'next'
    if key in (b't', b'T'):
        return 'today'
    if key in (b'q', b'Q', b'\r', b'\n'):
        return 'quit'
    return ''


month = date.today().replace(day=1)
fd = sys.stdin.fileno()
if not sys.stdin.isatty():
    render_month(month.year, month.month)
    print()
else:
    original = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        while True:
            print('\033[2J\033[H', end='')
            render_month(month.year, month.month)
            key = read_key(fd)
            if key == 'quit':
                break
            if key == 'today':
                month = date.today().replace(day=1)
            elif key == 'previous':
                month = (month - timedelta(days=1)).replace(day=1)
            elif key == 'next':
                month = (month.replace(day=28) + timedelta(days=4)).replace(day=1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, original)
        print('\033[0m\033[2J\033[H', end='', flush=True)
